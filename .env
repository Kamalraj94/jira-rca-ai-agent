JIRA_BASE_URL=<JIRA_DOMAIN>
JIRA_EMAIL=<JIRA_EMAIL>
JIRA_API_TOKEN=<JIRA_TOKEN>
JIRA_RCA_FIELD=customfield_10043
JIRA_TIMEOUT_SECONDS=30

LLM_API_URL=<LLM_API_END_POINT>
LLM_API_TOKEN=replace-with-real-token
LLM_AUTH_HEADER=Authorization
LLM_AUTH_PREFIX=Bearer
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=true
APP_LOG_LEVEL=INFO
MOCK_LLM_MODE=true